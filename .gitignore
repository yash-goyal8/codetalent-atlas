# --- Python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node / frontend ---
node_modules/
web/dist/
web/coverage/

# --- Environment and secrets ---
.env
.env.*
!.env.example

# --- OS and editor noise ---
.DS_Store
*.log
logs/

# --- Data (spec section 7) ---
# Raw, cached, interim, and user-level processed files never leave the machine.
# Only data/samples/ (small samples) and data/public/ (aggregate-only assets)
# are committed. The .gitkeep files preserve the directory skeleton.
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
