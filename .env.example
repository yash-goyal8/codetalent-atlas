# Copy to .env and fill in locally. Never commit real values.

# GitHub personal access token with read access to public data only (Milestone C+ enrichment)
GITHUB_TOKEN=

# Google Cloud project id for the BigQuery Sandbox (no billing attached)
GOOGLE_CLOUD_PROJECT=

# BigQuery dataset location
BIGQUERY_LOCATION=US

# Hard cap on bytes processed during Phase 3 discovery (250 GiB)
BIGQUERY_MAX_BYTES_PHASE3=268435456000

# BigQuery dataset id for temporary derived tables
DATASET_ID=codetalent_atlas

# Local cache directory for external API responses (gitignored)
CACHE_DIR=data/cache

# Log verbosity for structured JSON logs
LOG_LEVEL=INFO
